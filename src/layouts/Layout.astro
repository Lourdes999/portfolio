---
// BaseLayout.astro — Estructura HTML común a todo el sitio
import '../styles/global.css';
import Nav from '../components/Nav.astro';

const { titulo = 'Lourdes Melo | Portfolio' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content="Portfolio de Lourdes Melo, desarrolladora de software." />

    <!-- Google Fonts: Bricolage Grotesque + fuentes de respaldo -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Mrs+Saint+Delafield&family=Urbanist:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Nav />
    <main>
      <slot /> <!-- Acá se insertan las secciones de cada página -->
    </main>

    <script>
      // ---------- 1. NAVEGACIÓN CON TECLADO: salta de sección en sección ----------
      const secciones = [...document.querySelectorAll<HTMLElement>('.seccion')];

      // Detecta qué sección está en pantalla (la más cercana al borde superior)
      function seccionActual() {
        let indice = 0;
        let menor = Infinity;
        secciones.forEach((s, i) => {
          const distancia = Math.abs(s.getBoundingClientRect().top);
          if (distancia < menor) { menor = distancia; indice = i; }
        });
        return indice;
      }

      // Salta a la sección indicada
      function irA(i: number) {
        const limite = Math.max(0, Math.min(i, secciones.length - 1));
        secciones[limite].scrollIntoView({ behavior: 'instant' }); // Cambiá a 'smooth' si querés deslizamiento
      }

      document.addEventListener('keydown', (e) => {
        // No interfiere si se está escribiendo (ej: formulario de contacto)
        if ((e.target as HTMLElement).closest('input, textarea, select')) return;

        const i = seccionActual();
        const adelante = ['ArrowDown', 'PageDown'].includes(e.key) || (e.key === ' ' && !e.shiftKey);
        const atras = ['ArrowUp', 'PageUp'].includes(e.key) || (e.key === ' ' && e.shiftKey);

        if (adelante)             { e.preventDefault(); irA(i + 1); }
        else if (atras)           { e.preventDefault(); irA(i - 1); }
        else if (e.key === 'Home'){ e.preventDefault(); irA(0); }
        else if (e.key === 'End') { e.preventDefault(); irA(secciones.length - 1); }
      });

      // ---------- 2. ACTIVA LA ANIMACIÓN .reveal AL ENTRAR EN PANTALLA ----------
      const observador = new IntersectionObserver((entradas) => {
        entradas.forEach((entrada) => {
          if (entrada.isIntersecting) entrada.target.classList.add('visible');
        });
      }, { threshold: 0.2 });

      document.querySelectorAll('.reveal').forEach((el) => observador.observe(el));
    </script>
  </body>
</html>