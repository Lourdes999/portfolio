---
// Portada.astro — Primera sección (hero)
---
<section class="seccion portada" id="portada">

  <!-- ===== LADO IZQUIERDO (fondo olive) ===== -->
  <div class="portada__izq">
    <p class="portada__rol">Desarrollo de<br />Software</p>

    <div class="portada__bloque">
      <h1 class="portada__titulo">
        <span class="linea linea--1">port-</span>
        <span class="linea linea--2">folio</span>
      </h1>
      <!-- Firma: aparece como si se escribiera -->
      <span class="portada__firma">Lourdes Melo</span>
    </div>
  </div>

  <!-- ===== PANEL DERECHO (crema) ===== -->
  <aside class="portada__panel">
    <span class="portada__barras">//</span>
    <p class="portada__frase">Creo, desarrollo y transformo ideas en soluciones digitales</p>
  </aside>

  <!-- ===== ESPIRALES DECORATIVAS (se dibujan solas) ===== -->
  <svg class="espirales" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <!-- Espiral superior: cruza del fondo olive al panel -->
    <path
      class="espiral espiral--arriba"
      pathLength="1"
      d="M1255,0 C1320,80 1260,250 1160,330 C1060,400 1040,300 1120,210
         C1220,100 1350,40 1440,90 C1510,130 1500,260 1460,260 C1410,260 1420,60 1590,0"
    />
    <!-- Arcos inferiores -->
    <path
      class="espiral espiral--abajo"
      pathLength="1"
      d="M1290,1080 C1360,940 1490,900 1510,1080
         M1460,1080 C1530,940 1660,900 1680,1080
         M1625,1080 C1700,940 1830,900 1845,1080"
    />
  </svg>
</section>

<style>
  /* ---------- ESTRUCTURA: dos columnas ---------- */
  .portada {
    display: grid;
    grid-template-columns: 1fr 28%; /* Izquierda flexible | panel derecho */
    background: var(--olive);
  }

  /* ---------- LADO IZQUIERDO ---------- */
  .portada__izq {
    position: relative;
    z-index: 2; /* Por encima de las espirales */
    padding: 15vh 0 0 5.6vw;
  }

  /* "DESARROLLO DE SOFTWARE" */
  .portada__rol {
    font-family: var(--fuente-titulo);
    font-weight: 500;
    text-transform: uppercase;
    color: var(--crema);
    font-size: clamp(0.9rem, 1.4vw, 1.4rem);
    line-height: 1.5;
    animation: aparecer 0.8s var(--ease) both;
  }

  /* Contenedor del título + firma (la firma se posiciona respecto a este) */
  .portada__bloque {
    position: relative;
    width: fit-content;
    margin-top: 3vh;
  }

  /* "portfolio" */
  .portada__titulo {
    font-family: var(--fuente-titulo);
    font-weight: 500;
    text-transform: lowercase;
    color: var(--chile-rojo);
    font-size: clamp(5rem, 21vw, 26rem);
    line-height: 0.78;
    letter-spacing: -0.06em;
    /* SOMBRA PROVISORIA: la ajusto cuando vea tu imagen */
    text-shadow: 0 10px 25px rgba(60, 40, 10, 0.25);
  }

  /* Cada línea sube al cargar ("folio" un poquito después) */
  .linea {
    display: block;
    animation: subir 1s var(--ease) both;
  }
  .linea--2 { animation-delay: 0.15s; }

  /* "Lourdes Melo" */
  .portada__firma {
    position: absolute;
    left: 52%;
    top: 44%;
    font-family: var(--fuente-firma);
    color: var(--crema);
    font-size: clamp(2rem, 5.5vw, 6rem);
    white-space: nowrap;
    transform: rotate(-12deg);
    animation: firmar 1.4s var(--ease) 0.8s both;
  }

  /* ---------- PANEL DERECHO ---------- */
  .portada__panel {
    position: relative;
    z-index: 0; /* Debajo de las espirales */
    background: var(--crema);
    border-radius: 16px 0 0 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 2rem 3rem;
    text-align: center;
    color: var(--chile-rojo);
  }

  .portada__barras {
    font-family: var(--fuente-texto);
    font-size: clamp(2rem, 4vw, 4.5rem);
    font-style: italic;
    line-height: 1;
    animation: aparecer 0.8s var(--ease) 1s both;
  }

  .portada__frase {
    font-family: var(--fuente-texto);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: clamp(1rem, 1.9vw, 2.1rem);
    line-height: 1.45;
    max-width: 16ch;
    animation: aparecer 0.8s var(--ease) 1.2s both;
  }

  /* ---------- ESPIRALES ---------- */
  .espirales {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1; /* Entre el panel y el texto */
    pointer-events: none;
  }
  .espiral {
    fill: none;
    stroke: var(--chile-rojo);
    stroke-width: 9;
    stroke-linecap: round;
    stroke-dasharray: 1;   /* Truco para "dibujar" la línea */
    stroke-dashoffset: 1;
    animation: dibujar 2.5s ease-in-out 0.4s forwards;
  }
  .espiral--abajo { animation-delay: 1s; }

  /* ---------- ANIMACIONES ---------- */
  @keyframes subir {
    from { opacity: 0; transform: translateY(40%); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes aparecer {
    from { opacity: 0; transform: translateY(15px); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes firmar { /* Se revela de izquierda a derecha, como escribiéndose */
    from { opacity: 0; clip-path: inset(0 100% 0 0); }
    to   { opacity: 1; clip-path: inset(0 0 0 0); }
  }
  @keyframes dibujar {
    to { stroke-dashoffset: 0; }
  }

  /* ---------- CELULAR: panel abajo ---------- */
  @media (max-width: 768px) {
    .portada {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
    }
    .portada__izq { padding: 12vh 1.5rem 3rem; }
    .portada__panel {
      border-radius: 16px 16px 0 0;
      padding: 2.5rem 1.5rem;
    }
    .espiral--arriba { display: none; } /* Solo quedan los arcos inferiores */
  }
</style>