---
// Componente genérico: cada carpeta del portfolio (Sobre mí, Proyectos,
// Habilidades, Contacto) es una instancia de este mismo componente con
// distintas props. Así evitamos repetir el HTML cuatro veces.
interface Props {
  id: string;          // id de la sección, ej: "s1"
  nextId: string;       // a qué sección salta la pestaña, ej: "s2"
  catClass: string;     // usado para el atributo data-cat (colores)
  tabLabel: string;     // texto de la pestaña, ej: "SOBRE MÍ"
  striped?: string;     // "striped-a" | "striped-b" | undefined
  bulletItems: string[];
  photoPlaceholder: string;
  scriptWord: string;
  description: string;
}

const {
  id, nextId, catClass, tabLabel, striped,
  bulletItems, photoPlaceholder, scriptWord, description,
} = Astro.props as Props;
---
<section id={id} data-cat={catClass}>
  <div class="paper-half">
    <button class="tab" onclick={`jump('${nextId}')`}>{tabLabel}</button>
  </div>

  <div class:list={['color-half', striped]}>
    <div class="card-frame">
      <ul class="bullets">
        {bulletItems.map(item => <li class="tw">{item}</li>)}
      </ul>
      <div class="right-col">
        <div class="polaroid">
          <svg class="clip" viewBox="0 0 26 44">
            <path
              d="M13 2 C22 2 22 16 13 16 C6 16 6 26 13 26 C18 26 18 34 13 34"
              fill="none" stroke="#9aa0a6" stroke-width="3"
            />
          </svg>
          <div class="photo">{photoPlaceholder}</div>
        </div>
        <span class="script tw">{scriptWord}</span>
        <p class="desc tw">{description}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .paper-half{
    flex:0 0 24%;
    background:
      linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0/28px 28px,
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0/28px 28px,
      var(--linho);
    display:flex;
    align-items:flex-end;
    justify-content:flex-end;
    padding:0 6vw;
  }

  .color-half{
    flex:1;
    background:var(--c);
    display:grid;
    align-items:start;
    justify-content:center;
    padding:6vh 6vw;
    position:relative;
  }
  .color-half.striped-a{
    background:repeating-linear-gradient(90deg, var(--oliva) 0 46px, var(--blush) 46px 92px);
  }
  .color-half.striped-b{
    background:repeating-linear-gradient(90deg, var(--vinho) 0 46px, var(--blush) 46px 92px);
  }

  .card-frame{
    background:#fff;
    border-radius:20px;
    box-shadow:0 18px 40px rgba(58,37,48,0.22);
    padding:4vh 4vw;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:4vw;
    align-items:start;
    max-width:1000px;
    width:100%;
    color:var(--ink);
  }

  .bullets{ border-right:1.5px solid rgba(58,37,48,0.22); padding-right:4vw; list-style:none; }
  .bullets li{
    font-size:18px;
    margin-bottom:16px;
    position:relative;
    padding-left:18px;
  }
  .bullets li::before{ content:"•"; position:absolute; left:0; top:0; }

  .right-col{ position:relative; display:flex; flex-direction:column; align-items:flex-start; gap:14px; }

  .polaroid{
    background:#fff;
    padding:12px 12px 34px;
    border-radius:4px;
    box-shadow:0 14px 30px rgba(0,0,0,0.25);
    transform:rotate(-3deg);
    width:210px;
    position:relative;
  }
  .polaroid .photo{
    width:100%;
    height:150px;
    background:repeating-linear-gradient(45deg, rgba(0,0,0,0.06) 0 10px, transparent 10px 20px);
    border:1.5px dashed rgba(0,0,0,0.25);
    border-radius:2px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    color:rgba(0,0,0,0.45);
    text-align:center;
    padding:8px;
  }
  .clip{
    position:absolute;
    top:-22px; left:42%;
    width:26px; height:44px;
    transform:rotate(-8deg);
  }

  .script{
    font-family:'Fraunces', serif;
    font-style:italic;
    font-weight:500;
    font-size:34px;
    margin-top:6px;
  }
  .desc{
    font-size:14.5px;
    line-height:1.55;
    max-width:280px;
  }

  /* Color de cada carpeta según su categoría */
  [data-cat="sobre"] .tab, [data-cat="sobre"] .color-half{ --c:var(--oliva); --tc:var(--ink); }
  [data-cat="proyectos"] .tab, [data-cat="proyectos"] .color-half{ --c:var(--blush); --tc:var(--ink); }
  [data-cat="habilidades"] .tab, [data-cat="habilidades"] .color-half{ --c:var(--rosa); --tc:#fff; }
  [data-cat="contacto"] .tab, [data-cat="contacto"] .color-half{ --c:var(--vinho); --tc:#fff; }
</style>
